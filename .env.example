# MongoDB ulanish havolasi (Prisma)
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/sirdaryo_db?retryWrites=true&w=majority"

# Ilova nomi va asosiy domeni (Vercel yoki server manzili)
NEXT_PUBLIC_APP_NAME="Sirdaryo Xizmatlari"
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# Admin xavfsizlik sozlamalari
# Kuchli maxfiy PIN-kod (kamida 8 ta belgi, harflar va raqamlar tavsiya etiladi)
ADMIN_PIN="maxfiy_admin_pin_kod"

# Sessiya shifrlash uchun maxfiy kalit (HMAC SHA-256)
ADMIN_SESSION_SECRET="generatsiya_qilingan_tasodifiy_32_belgili_xavfsiz_kalit"
